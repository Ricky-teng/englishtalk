+
+/** 新裝置：輸入同步密碼，打開雲端的保險箱。密碼錯回傳 false */
+export async function unlockKeys(pass) {
+  const rv = lsJSON(VREMOTE);
+  if (!rv) return false;
+  const data = await Vault.unlock(pass, rv);
+  if (!data) return false;
+  const st = Store.load();
